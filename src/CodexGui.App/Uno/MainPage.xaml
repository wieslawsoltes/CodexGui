<Page x:Class="CodexGui.App.Uno.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CodexGui.App.Uno.Controls"
      Background="{StaticResource AppWindowBrush}"
      FontFamily="Inter, Segoe UI, Helvetica Neue, Arial">
  <Grid x:Name="ShellGrid"
        ColumnDefinitions="64,286,*"
        RowDefinitions="Auto,*">
    <controls:ShellNavRailView x:Name="NavRailPanel"
                               Grid.RowSpan="2"
                               Grid.Column="0" />

    <controls:ShellWorkspaceSidebarView x:Name="WorkspacePanel"
                                        Grid.RowSpan="2"
                                        Grid.Column="1" />

    <controls:ShellTopBarView Grid.Column="2"
                              Grid.Row="0" />

    <controls:ShellConversationWorkspaceView x:Name="ConversationWorkspace"
                                             Grid.Column="2"
                                             Grid.Row="1" />
  </Grid>
</Page>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="AppWindowColor">#F4F4F4</Color>
  <Color x:Key="RailColor">#EAEAEA</Color>
  <Color x:Key="SidebarColor">#F1F1F1</Color>
  <Color x:Key="PanelColor">#FFFFFF</Color>
  <Color x:Key="PanelMutedColor">#F8F8F8</Color>
  <Color x:Key="PanelTintColor">#EFEFEF</Color>
  <Color x:Key="BorderColor">#DEDEDE</Color>
  <Color x:Key="BorderStrongColor">#C7C7C7</Color>
  <Color x:Key="TextPrimaryColor">#171717</Color>
  <Color x:Key="TextSecondaryColor">#454545</Color>
  <Color x:Key="TextMutedColor">#707070</Color>
  <Color x:Key="AccentGreenColor">#1F7A3D</Color>
  <Color x:Key="AccentBlueColor">#0A56C2</Color>
  <Color x:Key="AccentAmberColor">#B06A10</Color>
  <Color x:Key="AccentRedColor">#B42318</Color>
  <Color x:Key="AccentNeutralColor">#636363</Color>
  <Color x:Key="ControlSurfaceColor">#FFFFFF</Color>
  <Color x:Key="ControlSurfaceHoverColor">#F3F3F3</Color>
  <Color x:Key="ControlSurfacePressedColor">#ECECEC</Color>
  <Color x:Key="ControlBorderHoverColor">#B6B6B6</Color>
  <Color x:Key="PrimaryButtonColor">#111111</Color>
  <Color x:Key="PrimaryButtonHoverColor">#242424</Color>
  <Color x:Key="PrimaryButtonPressedColor">#0A0A0A</Color>
  <Color x:Key="PrimaryButtonForegroundColor">#FFFFFF</Color>
  <Color x:Key="SelectionSurfaceColor">#ECECEC</Color>
  <Color x:Key="SelectionBorderColor">#CCCCCC</Color>

  <SolidColorBrush x:Key="AppWindowBrush" Color="{StaticResource AppWindowColor}" />
  <SolidColorBrush x:Key="RailBrush" Color="{StaticResource RailColor}" />
  <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
  <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
  <SolidColorBrush x:Key="PanelMutedBrush" Color="{StaticResource PanelMutedColor}" />
  <SolidColorBrush x:Key="PanelTintBrush" Color="{StaticResource PanelTintColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreenColor}" />
  <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlueColor}" />
  <SolidColorBrush x:Key="AccentAmberBrush" Color="{StaticResource AccentAmberColor}" />
  <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRedColor}" />
  <SolidColorBrush x:Key="AccentNeutralBrush" Color="{StaticResource AccentNeutralColor}" />
  <SolidColorBrush x:Key="ControlSurfaceBrush" Color="{StaticResource ControlSurfaceColor}" />
  <SolidColorBrush x:Key="ControlSurfaceHoverBrush" Color="{StaticResource ControlSurfaceHoverColor}" />
  <SolidColorBrush x:Key="ControlSurfacePressedBrush" Color="{StaticResource ControlSurfacePressedColor}" />
  <SolidColorBrush x:Key="ControlBorderHoverBrush" Color="{StaticResource ControlBorderHoverColor}" />
  <SolidColorBrush x:Key="PrimaryButtonBrush" Color="{StaticResource PrimaryButtonColor}" />
  <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="{StaticResource PrimaryButtonHoverColor}" />
  <SolidColorBrush x:Key="PrimaryButtonPressedBrush" Color="{StaticResource PrimaryButtonPressedColor}" />
  <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{StaticResource PrimaryButtonForegroundColor}" />
  <SolidColorBrush x:Key="SelectionSurfaceBrush" Color="{StaticResource SelectionSurfaceColor}" />
  <SolidColorBrush x:Key="SelectionBorderBrush" Color="{StaticResource SelectionBorderColor}" />

  <SolidColorBrush x:Key="ShellWindowBrush" Color="{StaticResource AppWindowColor}" />
  <SolidColorBrush x:Key="ShellPanelBrush" Color="{StaticResource PanelColor}" />
  <SolidColorBrush x:Key="ShellPanelMutedBrush" Color="{StaticResource PanelMutedColor}" />
  <SolidColorBrush x:Key="ShellBorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="ShellTextBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="ShellMutedBrush" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="ShellAccentBrush" Color="{StaticResource AccentBlueColor}" />

  <Style x:Key="BaseButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource ControlSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style x:Key="RailButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <Style x:Key="SidebarActionButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="10,7" />
  </Style>

  <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Margin" Value="0,0,6,6" />
  </Style>

  <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
    <Setter Property="Background" Value="{StaticResource PrimaryButtonBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource PrimaryButtonBrush}" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryButtonForegroundBrush}" />
  </Style>

  <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
    <Setter Property="Background" Value="{StaticResource PanelTintBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
  </Style>

  <Style x:Key="WarningButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
    <Setter Property="Background" Value="#FFF4E8" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}" />
    <Setter Property="Foreground" Value="#7B3E00" />
  </Style>

  <Style x:Key="PanelToggleStyle" TargetType="ToggleButton">
    <Setter Property="Background" Value="{StaticResource ControlSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style x:Key="CommandFieldTextBoxStyle" TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource ControlSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="9,6" />
  </Style>

  <Style x:Key="ComposerInputTextBoxStyle" TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource ControlSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="MinHeight" Value="84" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="PickerFieldComboBoxStyle" TargetType="ComboBox">
    <Setter Property="Background" Value="{StaticResource ControlSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="MinWidth" Value="140" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style x:Key="RailFlyoutCardBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource PanelMutedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10" />
  </Style>

  <Style x:Key="TopBarCardBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource ControlSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <Style x:Key="TopBarOverviewCardBorderStyle" TargetType="Border" BasedOn="{StaticResource TopBarCardBorderStyle}">
    <Setter Property="Background" Value="{StaticResource PanelMutedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
  </Style>

  <Style x:Key="TopBarInlineBadgeBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SelectionSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SelectionBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="8,4" />
  </Style>

  <Style x:Key="StatusChipBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource PanelMutedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>

  <Style x:Key="ThreadRowBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="8,8" />
  </Style>

  <Style x:Key="ConversationBubbleBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="10,10" />
    <Setter Property="Margin" Value="0" />
  </Style>

  <Style x:Key="ComposerSurfaceBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <Style x:Key="PreviewCodeBlockBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource PanelMutedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8" />
  </Style>

  <Style x:Key="ApprovalPanelBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource PanelMutedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10" />
  </Style>

  <Style x:Key="ApprovalCardBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource ControlSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <Style x:Key="ApprovalQuestionBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource ControlSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8" />
  </Style>

  <Style x:Key="FlatListViewItemStyle" TargetType="ListViewItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style x:Key="WindowTitleTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="PanelTitleTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

  <Style x:Key="TopBarHeadlineTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

  <Style x:Key="TopBarInlineBadgeTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

  <Style x:Key="SectionLabelTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
  </Style>

  <Style x:Key="BodyTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="MutedTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
  </Style>

  <Style x:Key="ThreadTitleTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

  <Style x:Key="ChipLabelTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
  </Style>

  <Style x:Key="ChipValueTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

  <Style x:Key="CodeBlockTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

  <Style x:Key="BrandGlyphTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryButtonForegroundBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</ResourceDictionary>

<UserControl x:Class="CodexGui.App.Uno.Controls.ShellWorkspaceSidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CodexGui.App.ViewModels"
             xmlns:conv="using:CodexGui.App.Uno.Converters">
  <UserControl.Resources>
    <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
  </UserControl.Resources>
  <Border Background="{StaticResource SidebarBrush}"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="0,0,1,0"
          Padding="12">
    <Grid RowDefinitions="Auto,*"
          RowSpacing="10">
      <StackPanel Spacing="4">
        <TextBlock Text="Workspace"
                   Style="{StaticResource SectionLabelTextStyle}" />
        <TextBlock Text="{Binding CurrentWorkspaceTitle}"
                   Style="{StaticResource PanelTitleTextStyle}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding CurrentWorkspaceSubtitle}"
                   Style="{StaticResource MutedTextStyle}"
                   TextWrapping="Wrap"
                   MaxLines="2" />

        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="8"
              Margin="0,8,0,0">
          <TextBlock Text="Threads"
                     Style="{StaticResource PanelTitleTextStyle}" />
          <TextBlock Grid.Column="1"
                     Text="{Binding ThreadCountLabel}"
                     Style="{StaticResource BodyTextStyle}" />
        </Grid>

        <StackPanel Orientation="Horizontal"
                    Spacing="8"
                    Margin="0,4,0,0">
          <Button Style="{StaticResource PrimaryButtonStyle}"
                  Command="{Binding ConnectCommand}"
                  Visibility="{Binding IsConnected, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal"
                        Spacing="6">
              <SymbolIcon Symbol="Sync" />
              <TextBlock Text="Connect sessions" />
            </StackPanel>
          </Button>

          <Button Style="{StaticResource SidebarActionButtonStyle}"
                  Command="{Binding RefreshCommand}"
                  Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal"
                        Spacing="6">
              <SymbolIcon Symbol="Refresh" />
              <TextBlock Text="Refresh sessions" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>

      <ListView x:Name="ThreadList"
                Grid.Row="1"
                Background="Transparent"
                BorderThickness="0"
                ItemContainerStyle="{StaticResource FlatListViewItemStyle}"
                ItemsSource="{Binding RecentThreads}"
                SelectedItem="{Binding SelectedThread, Mode=TwoWay}">
      <ListView.ItemTemplate>
          <DataTemplate x:DataType="vm:ThreadListEntryViewModel">
            <Border Style="{StaticResource ThreadRowBorderStyle}">
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="10">
                  <TextBlock Text="{Binding Title}"
                             Style="{StaticResource ThreadTitleTextStyle}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding TimeLabel}"
                             Style="{StaticResource MutedTextStyle}" />
                </Grid>
                <TextBlock Text="{Binding Preview}"
                           Style="{StaticResource BodyTextStyle}"
                           MaxLines="2"
                           TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="10">
                  <TextBlock Text="{Binding Meta}"
                             Style="{StaticResource MutedTextStyle}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding Badge}"
                             Style="{StaticResource MutedTextStyle}" />
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Grid>
  </Border>
</UserControl>

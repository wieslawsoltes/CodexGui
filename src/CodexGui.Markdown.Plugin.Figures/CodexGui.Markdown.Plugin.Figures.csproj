<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>true</IsPackable>
    <PackageId>CodexGui.Markdown.Plugin.Figures</PackageId>
    <Title>CodexGui Markdown Figures Plugin</Title>
    <Description>Figure parser registration for the Uno CodexGui markdown stack.</Description>
    <PackageTags>$(PackageTags);uno;markdown;plugin;figures</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Uno/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodexGui.Markdown.Core\CodexGui.Markdown.Core.csproj" />
  </ItemGroup>
</Project>

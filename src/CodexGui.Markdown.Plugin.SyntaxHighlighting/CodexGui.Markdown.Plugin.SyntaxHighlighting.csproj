<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>true</IsPackable>
    <PackageId>CodexGui.Markdown.Plugin.SyntaxHighlighting</PackageId>
    <Title>CodexGui Markdown Syntax Highlighting Plugin</Title>
    <Description>Built-in syntax highlighting for the Uno CodexGui markdown stack.</Description>
    <PackageTags>$(PackageTags);uno;markdown;plugin;syntax-highlighting;code</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Uno/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodexGui.Markdown.Core\CodexGui.Markdown.Core.csproj" />
  </ItemGroup>
</Project>

<Page x:Class="CodexGui.Markdown.Sample.Uno.MainPage"
      x:Name="Root"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:md="using:CodexGui.Markdown.Controls"
      mc:Ignorable="d"
      d:DesignHeight="900"
      d:DesignWidth="1500">
  <Grid Background="#F8FAFC">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Margin="24,24,24,12"
            Padding="24"
            Background="#FFFFFF"
            BorderBrush="#D7E1EC"
            BorderThickness="1"
            CornerRadius="24">
      <Grid ColumnSpacing="24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Spacing="10">
          <TextBlock Text="PRETEXT-BACKED UNO MARKDOWN"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="#2563EB" />
          <TextBlock Text="Markdown migration gallery"
                     FontSize="34"
                     FontWeight="SemiBold"
                     Foreground="#0F172A"
                     FontFamily="Georgia" />
          <TextBlock Text="The sample renders the Uno markdown control through the new IR and Pretext layout path, including alerts, custom containers, definition lists, figures, footers, math, mermaid, tables, and TextMate-backed fenced code blocks."
                     MaxWidth="920"
                     TextWrapping="WrapWholeWords"
                     Foreground="#475569" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Spacing="10"
                    HorizontalAlignment="Right">
          <TextBlock Text="{x:Bind ViewModel.DocumentCountLabel, Mode=OneWay}"
                     HorizontalAlignment="Right"
                     FontWeight="SemiBold"
                     Foreground="#0F172A" />
          <TextBlock Text="{x:Bind ViewModel.SelectedDocumentDescription, Mode=OneWay}"
                     MaxWidth="300"
                     TextWrapping="WrapWholeWords"
                     HorizontalAlignment="Right"
                     Foreground="#64748B" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1"
          Margin="24,0,24,24"
          ColumnSpacing="18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.05*" />
        <ColumnDefinition Width="0.95*" />
      </Grid.ColumnDefinitions>

      <Border Padding="18"
              Background="#FFFFFF"
              BorderBrush="#D7E1EC"
              BorderThickness="1"
              CornerRadius="20">
        <Grid RowSpacing="14">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal"
                        Spacing="12"
                        VerticalAlignment="Center">
              <TextBlock Text="Sample"
                         VerticalAlignment="Center"
                         Foreground="#334155" />
              <ComboBox Width="320"
                        DisplayMemberPath="Title"
                        ItemsSource="{x:Bind ViewModel.Documents, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedDocument, Mode=TwoWay}" />
              <Button Content="Reset Text"
                      Click="OnResetTextClicked" />
              <CheckBox Content="Enable block editing"
                        IsChecked="{x:Bind ViewModel.IsEditingEnabled, Mode=TwoWay}" />
              <TextBlock Text="Code editor:"
                         VerticalAlignment="Center" />
              <ComboBox Width="240"
                        DisplayMemberPath="Label"
                        ItemsSource="{x:Bind ViewModel.CodeEditorOptions, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedCodeEditor, Mode=TwoWay}" />
              <ComboBox Width="140"
                        ItemsSource="{x:Bind ViewModel.PresentationModes, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.EditorPresentationMode, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
              <TextBlock Text="File"
                         VerticalAlignment="Center"
                         Foreground="#334155" />
              <TextBox Width="520"
                       Text="{x:Bind ViewModel.CurrentFilePath, Mode=TwoWay}"
                       PlaceholderText="/path/to/file.md" />
              <Button Content="New"
                      Click="OnNewDocumentClicked" />
              <Button Content="Open"
                      Click="OnOpenFromPathClicked" />
              <Button Content="Save"
                      Click="OnSaveToPathClicked" />
              <TextBlock Text="{x:Bind ViewModel.CurrentFileDisplay, Mode=OneWay}"
                         VerticalAlignment="Center"
                         Foreground="#64748B" />
            </StackPanel>

            <TextBlock Text="Markdown source"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#0F172A" />
            <TextBlock Text="Edit the source on the left. The preview on the right re-renders through the Uno markdown control using the migrated parsing, IR, layout, and plugin pipeline."
                       TextWrapping="WrapWholeWords"
                       Foreground="#64748B" />
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       TextWrapping="WrapWholeWords"
                       Foreground="#2563EB" />
          </StackPanel>

          <TextBox x:Name="MarkdownEditor"
                   Grid.Row="1"
                   Text="{x:Bind ViewModel.MarkdownText, Mode=OneWay}"
                   TextChanged="OnMarkdownEditorTextChanged"
                   AcceptsReturn="True"
                   TextWrapping="NoWrap"
                   FontFamily="Cascadia Mono"
                   FontSize="13"
                   VerticalAlignment="Stretch"
                   HorizontalAlignment="Stretch"
                   Padding="12"
                   BorderBrush="#CBD5E1"
                   BorderThickness="1"
                   CornerRadius="14"
                   Background="#F8FAFC" />
        </Grid>
      </Border>

      <Border Grid.Column="1"
              Padding="18"
              Background="#FFFFFF"
              BorderBrush="#D7E1EC"
              BorderThickness="1"
              CornerRadius="20">
        <Grid RowSpacing="14">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <StackPanel Spacing="8">
            <TextBlock Text="Rendered preview"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#0F172A" />
            <TextBlock Text="The preview uses `MarkdownTextBlock` on Uno and the shared markdown core. Fenced code prefers TextMate grammars and falls back to the built-in tokenizer when a grammar is unavailable."
                       TextWrapping="WrapWholeWords"
                       Foreground="#64748B" />
            <TextBlock Text="Click a preview block to edit in place or reveal its source span in the editor. Hover shows the resolved hit region."
                       TextWrapping="WrapWholeWords"
                       Foreground="#64748B" />
          </StackPanel>

          <ScrollViewer Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="PreviewHost"
                  Margin="0,0,4,0"
                  PointerMoved="OnPreviewHostPointerMoved"
                  PointerExited="OnPreviewHostPointerExited"
                  PointerPressed="OnPreviewHostPointerPressed">
              <md:MarkdownTextBlock x:Name="Preview"
                                    Markdown="{x:Bind ViewModel.PreviewMarkdownText, Mode=OneWay}"
                                    BaseUri="{x:Bind ViewModel.BaseUri, Mode=OneWay}"
                                    IsEditingEnabled="{x:Bind ViewModel.IsEditingEnabled, Mode=TwoWay}"
                                    EditorPresentationMode="{x:Bind ViewModel.EditorPresentationMode, Mode=TwoWay}"
                                    FontSize="14"
                                    Foreground="#1F2328"
                                    TextWrapping="Wrap" />
              <Canvas x:Name="PreviewOverlay"
                      IsHitTestVisible="False">
                <Border x:Name="PreviewOverlayBorder"
                        BorderBrush="#2563EB"
                        BorderThickness="1"
                        Background="#1A2563EB"
                        CornerRadius="6"
                        Visibility="Collapsed" />
              </Canvas>
            </Grid>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>

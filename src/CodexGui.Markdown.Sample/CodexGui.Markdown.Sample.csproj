<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <UnoFeatures>SkiaRenderer;</UnoFeatures>
    <ApplicationTitle>CodexGui Markdown Sample</ApplicationTitle>
    <ApplicationId>com.wieslawsoltes.codexgui.markdown.sample</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationPublisher>CodexGui</ApplicationPublisher>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Uno/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="Uno/**/*.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Pretext.Uno" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodexGui.Markdown\CodexGui.Markdown.csproj" />
    <ProjectReference Include="..\CodexGui.Markdown.Plugin.Alerts\CodexGui.Markdown.Plugin.Alerts.csproj" />
    <ProjectReference Include="..\CodexGui.Markdown.Plugin.CustomContainers\CodexGui.Markdown.Plugin.CustomContainers.csproj" />
    <ProjectReference Include="..\CodexGui.Markdown.Plugin.DefinitionLists\CodexGui.Markdown.Plugin.DefinitionLists.csproj" />
    <ProjectReference Include="..\CodexGui.Markdown.Plugin.Figures\CodexGui.Markdown.Plugin.Figures.csproj" />
    <ProjectReference Include="..\CodexGui.Markdown.Plugin.Footers\CodexGui.Markdown.Plugin.Footers.csproj" />
    <ProjectReference Include="..\CodexGui.Markdown.Plugin.Math\CodexGui.Markdown.Plugin.Math.csproj" />
    <ProjectReference Include="..\CodexGui.Markdown.Plugin.Mermaid\CodexGui.Markdown.Plugin.Mermaid.csproj" />
    <ProjectReference Include="..\CodexGui.Markdown.Plugin.SyntaxHighlighting\CodexGui.Markdown.Plugin.SyntaxHighlighting.csproj" />
    <ProjectReference Include="..\CodexGui.Markdown.Plugin.TextMate\CodexGui.Markdown.Plugin.TextMate.csproj" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>CodexGui.Markdown.Core</PackageId>
    <Title>CodexGui Markdown Core</Title>
    <Description>UI-agnostic markdown parsing, layout, and source-editing primitives for CodexGui.Markdown.</Description>
    <PackageTags>$(PackageTags);markdown;markdig;pretext;core</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" />
    <PackageReference Include="Pretext" />
  </ItemGroup>
</Project>

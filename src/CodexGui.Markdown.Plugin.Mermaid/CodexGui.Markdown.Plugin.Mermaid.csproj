<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);MERMAID_PARSER_ONLY</DefineConstants>
    <IsPackable>true</IsPackable>
    <PackageId>CodexGui.Markdown.Plugin.Mermaid</PackageId>
    <Title>CodexGui Markdown Mermaid Plugin</Title>
    <Description>Mermaid parser registration for the Uno CodexGui markdown stack.</Description>
    <PackageTags>$(PackageTags);uno;markdown;plugin;mermaid;diagrams</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="MermaidNativeRendering.cs" />
    <Compile Include="Uno/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodexGui.Markdown.Core\CodexGui.Markdown.Core.csproj" />
  </ItemGroup>
</Project>

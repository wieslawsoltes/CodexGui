<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop</TargetFrameworks>
    <OutputType>Library</OutputType>
    <GenerateLibraryLayout>true</GenerateLibraryLayout>
    <UnoSingleProject>true</UnoSingleProject>
    <UnoFeatures>SkiaRenderer;</UnoFeatures>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>true</IsPackable>
    <PackageId>CodexGui.Markdown</PackageId>
    <Title>CodexGui Markdown</Title>
    <Description>Uno Platform markdown rendering and editing primitives for CodexGui-style conversation and document surfaces.</Description>
    <PackageTags>$(PackageTags);uno;markdown;markdig;pretext</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Uno/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="Uno/**/*.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Pretext" />
    <PackageReference Include="Pretext.Uno" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodexGui.Markdown.Core\CodexGui.Markdown.Core.csproj" />
    <ProjectReference Include="..\CodexGui.Markdown.Plugin.Math\CodexGui.Markdown.Plugin.Math.csproj" />
    <ProjectReference Include="..\CodexGui.Markdown.Plugin.Mermaid\CodexGui.Markdown.Plugin.Mermaid.csproj" />
  </ItemGroup>
</Project>
